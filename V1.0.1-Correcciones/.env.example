# === TinoProp — Variables de entorno (EJEMPLO) ===
# Copia como .env y ajusta los valores para tu entorno.

DB_HOST=localhost
DB_NAME=tinoprop
DB_USER=tu_usuario
DB_PASS=tu_password_segura
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Lista de IPs de proxies de confianza (separadas por coma).
TRUSTED_PROXIES=

# Ruta del archivo de log de errores PHP.
ERROR_LOG_PATH=logs/php_errors.log
