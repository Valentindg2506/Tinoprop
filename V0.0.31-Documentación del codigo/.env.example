# =============================================================================
# === TinoProp — Variables de entorno (EJEMPLO) — V0.0.31 Pre-Producción ===
# =============================================================================
#
# ¿Qué es este archivo?
# ---------------------
# Este archivo (.env.example) es una PLANTILLA. Contiene las variables de
# configuración que TinoProp necesita para funcionar, pero con valores ficticios.
#
# ¿Cómo se usa?
# ------------
# 1. Copia este archivo como ".env":   cp .env.example .env
# 2. Edita .env y pon los valores REALES de tu entorno (servidor, contraseñas...).
# 3. NUNCA subas el archivo .env a Git (ya está en .gitignore por seguridad).
#
# ¿Por qué no se ponen las credenciales directamente en el código PHP?
# Porque si el código se sube a un repositorio público (o se comparte),
# las contraseñas quedarían expuestas. Las variables de entorno se leen
# solo en el servidor y nunca salen de él.
# =============================================================================

# ---------------------------------------------------------------------------
# CONEXIÓN A LA BASE DE DATOS (MySQL/MariaDB)
# ---------------------------------------------------------------------------

# DB_HOST: dirección del servidor de base de datos.
# → "localhost" significa que MySQL está en el mismo servidor que la web.
# → En producción podría ser una IP o dominio externo (ej: "db.miservidor.com").
DB_HOST=localhost

# DB_NAME: nombre de la base de datos donde TinoProp guarda toda su información
# (usuarios, inmobiliarias, propiedades, clientes, visitas, etc.).
DB_NAME=tinoprop

# DB_USER: usuario de MySQL con permisos para leer/escribir en DB_NAME.
# → En producción, NUNCA uses "root". Crea un usuario específico con
#   solo los permisos necesarios (SELECT, INSERT, UPDATE, DELETE).
DB_USER=tu_usuario

# DB_PASS: contraseña del usuario de MySQL.
# → Usa una contraseña FUERTE (mín. 12 caracteres, mayúsculas, números, símbolos).
# → NUNCA la compartas ni la pongas en código fuente.
DB_PASS=tu_password_segura

# DB_CHARSET: juego de caracteres para la conexión.
# → utf8mb4 soporta TODOS los caracteres Unicode, incluyendo emojis (🏠).
# → Es el estándar recomendado. "utf8" de MySQL solo soporta 3 bytes (incompleto).
DB_CHARSET=utf8mb4

# DB_COLLATION: reglas de comparación y ordenación de textos.
# → "utf8mb4_unicode_ci" ordena correctamente caracteres acentuados (á=a, ñ=n...)
# → "ci" = Case Insensitive (no distingue mayúsculas de minúsculas al buscar).
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# PROXIES DE CONFIANZA
# ---------------------------------------------------------------------------
# TRUSTED_PROXIES: lista de IPs de proxies/balanceadores de carga de confianza,
# separadas por coma.
# → Si TinoProp está detrás de un proxy inverso (Nginx, Cloudflare, AWS ELB...),
#   la IP real del usuario llega en la cabecera X-Forwarded-For.
#   Debemos indicar qué proxies son de confianza para no aceptar IPs falsificadas.
# → Si no usas proxy, déjalo vacío.
# → Ejemplo: TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# RUTA DE LOG DE ERRORES
# ---------------------------------------------------------------------------
# ERROR_LOG_PATH: ruta (relativa a la raíz del proyecto) donde PHP guardará
# los errores en vez de mostrarlos en pantalla.
# → En producción, los errores NUNCA deben mostrarse al usuario (revelan
#   información sensible). Se registran en este archivo para depuración.
# → Asegúrate de que la carpeta "logs/" existe y Apache tiene permisos de escritura.
ERROR_LOG_PATH=logs/php_errors.log
