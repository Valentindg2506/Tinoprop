# === TinoProp .gitignore ===

# Configuración con credenciales
inc/config.php

# Cache Python
__pycache__/
*.pyc
*.pyo

# Subidas de usuarios
uploads/
documentos/
storage/uploads/
storage/documentacion/

# Base de datos (migraciones contienen estructura sensible)
database/*.sql

# Entorno local
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
